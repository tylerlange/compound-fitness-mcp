# Copy to .env and fill in. .env is git-ignored. Never commit real values.

# Required. Directory holding training.db, coaching-profile.md, gym.md and
# aliases.yaml. Keep it OUTSIDE the repo so personal data can never be
# committed; `bin/coach init` creates it. (`make demo` uses ./demo-data.)
COACH_DATA_DIR=/path/outside/the/repo/fitness-coach

# Model for the agent: any pydantic-ai model string, plus the matching key.
COACH_MODEL=google:gemini-3.6-flash
GOOGLE_API_KEY=your-api-key-here
# ANTHROPIC_API_KEY=your-api-key-here
# OPENAI_API_KEY=your-api-key-here

# Optional overrides
# PERSONA_PROMPT_PATH=./persona-system-prompt.md
# COACH_CORE_DIR=.               # where the strength_coach package lives

# Watched-folder importer (importer/watcher.py)
# INBOX_DIR=$COACH_DATA_DIR/inbox
# POLL_SECONDS=30
# STABILITY_SECONDS=5

# Evals (evals/run.py)
# COACH_ENDPOINT=http://localhost:8000/v1/chat/completions
# COACH_EVAL_MODEL=fitness-coach
# COACH_DB_PATH=$COACH_DATA_DIR/training.db

# Destructive-tool confirmation gate (optional)
# COACH_CONFIRM_TTL_S=600          # seconds a preview token stays valid
# COACH_AUDIT_LOG=$COACH_DATA_DIR/audit.jsonl   # one line per destructive-tool call
